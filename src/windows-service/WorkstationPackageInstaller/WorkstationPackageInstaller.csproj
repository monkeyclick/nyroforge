<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>WorkstationPackageInstaller</AssemblyName>
    <RootNamespace>WorkstationPackageInstaller</RootNamespace>
    <Version>2.0.0</Version>
    <Authors>EC2 Workstation Manager</Authors>
    <Description>Windows Service for post-boot package installation on EC2 workstations</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- AWS SDK for .NET v4. Ships net8.0 assets, which load on net10.0.
         See Program.cs for AWSConfigs.InitializeCollections: v4 leaves response
         collections null by default where v3 initialised them to empty. -->
    <PackageReference Include="AWSSDK.Core" Version="4.0.102.1" />
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="4.0.103.5" />
    <PackageReference Include="AWSSDK.CloudWatchLogs" Version="4.0.103.4" />
    <!-- Downloads admin-uploaded installers from the packages bucket using
         instance profile credentials, so nothing depends on a presigned URL
         that expires while a workstation is stopped. -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.102.4" />

    <!-- Windows Services -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />

    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />

    <!-- Configuration -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />

    <!-- HTTP Client -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />

    <!-- System.Text.Json is part of the base class library on net10.0; an
         explicit reference would only serve to pin an older copy than the
         runtime ships. The previous 8.0.4 pin was two security patches behind. -->
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>