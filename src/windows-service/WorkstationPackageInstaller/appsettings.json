{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "WorkstationPackageInstaller": "Debug"
    }
  },
  "ServiceConfiguration": {
    "PollingIntervalSeconds": 30,
    "MaxConcurrentInstallations": 3,
    "MaxRetries": 3,
    "RetryDelaySeconds": 60,
    "InstallTimeoutMinutes": 30,
    "ResourceMonitoring": {
      "CpuThresholdPercent": 80,
      "MemoryThresholdPercent": 85,
      "DiskIOThresholdPercent": 90,
      "CheckIntervalSeconds": 10
    }
  },
  "AWS": {
    "Region": "us-west-2",
    "DynamoDB": {
      "PackageQueueTableName": "WorkstationPackageQueue",
      "BootstrapPackagesTableName": "WorkstationBootstrapPackages"
    },
    "CloudWatchLogs": {
      "LogGroupName": "/aws/workstation/package-installer",
      "LogStreamPrefix": "workstation-"
    }
  },
  "_SecurityComment": "RequirePackageHash=false grandfathers packages that have no expectedSha256 yet; any package that DOES carry a hash is still verified and refused on mismatch. Once every catalog package has a hash, set this to true to fail closed. AllowedDownloadHosts + HTTPS are always enforced and are the primary defense against arbitrary-URL execution.",
  "Security": {
    "RequirePackageHash": false,
    "AllowedDownloadHosts": [
      "*.s3.us-west-2.amazonaws.com",
      "*.s3.amazonaws.com",
      "*.cloudfront.net",
      "ec2-windows-nvidia-drivers.s3.amazonaws.com",
      "us.download.nvidia.com",
      "drivers.amd.com",
      "www.7-zip.org",
      "get.videolan.org",
      "download.documentfoundation.org",
      "dl.google.com",
      "github.com",
      "ardownload2.adobe.com",
      "www.gyan.dev",
      "www.python.org",
      "cdn-fastly.obsproject.com",
      "download.mozilla.org",
      "code.visualstudio.com",
      "nodejs.org",
      "download.blender.org",
      "www.amazondcv.com"
    ]
  }
}